rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read and write only their own plans.
    match /users/{uid}/plans/{planId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlan(request.resource.data);
    }

    // Preferences, e.g. the Workout of the Day mode: users/{uid}/settings/prefs.
    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'prefs' && validSettings(request.resource.data);
    }

    // Logged Workout of the Day results, id "{day}-{mode}".
    match /users/{uid}/wodResults/{resultId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validWodResult(resultId, request.resource.data);
    }

    // Public usernames. usernames/{lowercase name} is the uniqueness lock: it can only be created
    // if it doesn't exist yet, together with the owner's profile, and never changed afterwards.
    match /usernames/{key} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9_.-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameKey == key;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameKey', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_.-]{3,20}$')
        && request.resource.data.usernameKey == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // WOD leaderboards: one board per day and version ("2026-11-02-solo"), one entry per user.
    // Any signed-in user can read; users write only their own entry, under their own username.
    match /leaderboards/{board}/entries/{uid} {
      allow read: if request.auth != null;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && board.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(solo|team)$')
        && validEntry(request.resource.data)
        && request.resource.data.username == get(/databases/$(database)/documents/profiles/$(uid)).data.username;
    }

    // Payments (ready for the "Run Payments with Stripe" extension). Only the extension writes
    // here, with the Admin SDK; users can read their own subscription status.
    match /customers/{uid} {
      allow read: if isOwner(uid);
      match /{document=**} {
        allow read: if isOwner(uid);
      }
    }
    // Products and prices are public so a pricing page can list them.
    match /products/{productId} {
      allow read: if true;
      match /{document=**} {
        allow read: if true;
      }
    }

    // Everything else is denied (no other match blocks).

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPlan(d) {
      return d.keys().hasOnly(['inputs', 'done', 'logs', 'createdAt', 'updatedAt'])
        && d.inputs is map
        && d.done is map
        && d.done.size() <= 200
        && (!('logs' in d) || (d.logs is map && d.logs.size() <= 200));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['wodMode', 'updatedAt'])
        && (!('wodMode' in d) || d.wodMode in ['solo', 'team']);
    }

    function shortText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validEntry(d) {
      return d.keys().hasOnly(['username', 'value', 'display', 'kind', 'day', 'title', 'updatedAt'])
        && d.username is string
        && d.value is number && d.value >= 0 && d.value <= 1000000
        && d.display is string && d.display.size() <= 30
        && d.kind in ['time', 'rounds', 'count']
        && d.day is int && d.day >= 1 && d.day <= 365
        && d.title is string && d.title.size() <= 80;
    }

        function validWodResult(id, d) {
      return d.keys().hasOnly(['day', 'mode', 'title', 'benchmark', 'date', 'score', 'value', 'kind', 'shared', 'partner', 'weight', 'notes', 'updatedAt'])
        && (!('value' in d) || (d.value is number && d.value >= 0 && d.value <= 1000000))
        && (!('kind' in d) || d.kind in ['time', 'rounds', 'count'])
        && (!('shared' in d) || d.shared is bool)
        && d.day is int && d.day >= 1 && d.day <= 365
        && d.mode in ['solo', 'team']
        && id == string(d.day) + '-' + d.mode
        && d.benchmark is bool
        && d.title is string && d.title.size() <= 80
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.score is string && d.score.size() >= 1 && d.score.size() <= 60
        && shortText(d, 'partner', 60)
        && shortText(d, 'weight', 60)
        && shortText(d, 'notes', 300);
    }
  }
}
