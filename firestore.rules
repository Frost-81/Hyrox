rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read and write only their own plans.
    match /users/{uid}/plans/{planId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlan(request.resource.data);
    }

    // Everything else is denied (no other match blocks).

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPlan(d) {
      return d.keys().hasOnly(['inputs', 'done', 'logs', 'createdAt', 'updatedAt'])
        && d.inputs is map
        && d.done is map
        && d.done.size() <= 200
        && (!('logs' in d) || (d.logs is map && d.logs.size() <= 200));
    }
  }
}
