rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read and write only their own plans.
    match /users/{uid}/plans/{planId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlan(request.resource.data);
    }

    // Preferences, e.g. the Workout of the Day mode: users/{uid}/settings/prefs.
    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'prefs' && validSettings(request.resource.data);
    }

    // Workout of the Day results are no longer logged. Owners can still read and delete old ones,
    // so deleting an account clears them.
    match /users/{uid}/wodResults/{resultId} {
      allow read, delete: if isOwner(uid);
    }

    // What the user has paid for: { stripeId, access: { plan, wod } }. Only the Stripe webhook
    // (functions/payments.js) writes it, with the Admin SDK; the owner can read it.
    match /customers/{uid} {
      allow read: if isOwner(uid);
    }

    // Everything else is denied (no other match blocks), including mfaCodes/{uid},
    // which only the Cloud Functions use.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && mfaPassed();
    }

    // Users who turned on email sign-in codes must enter one for each password sign-in.
    // functions/index.js lists the auth_time of verified sign-ins in the `mfa` claim.
    function mfaPassed() {
      return request.auth.token.get('mfaEmail', false) != true
        || request.auth.token.firebase.sign_in_provider != 'password'
        || request.auth.token.auth_time in request.auth.token.get('mfa', []);
    }

    function validPlan(d) {
      return d.keys().hasOnly(['inputs', 'done', 'logs', 'createdAt', 'updatedAt'])
        && d.inputs is map
        && d.done is map
        && d.done.size() <= 200
        && (!('logs' in d) || (d.logs is map && d.logs.size() <= 200));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['wodMode', 'updatedAt'])
        && (!('wodMode' in d) || d.wodMode in ['solo', 'team']);
    }
  }
}
