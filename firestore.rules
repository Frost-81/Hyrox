rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read and write only their own plans.
    match /users/{uid}/plans/{planId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlan(request.resource.data);
    }

    // Preferences, e.g. the Workout of the Day mode: users/{uid}/settings/prefs.
    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'prefs' && validSettings(request.resource.data);
    }

    // Workout of the Day results are no longer logged. Owners can still read and delete old ones,
    // so deleting an account clears them.
    match /users/{uid}/wodResults/{resultId} {
      allow read, delete: if isOwner(uid);
    }

    // Payments ("Run Payments with Stripe" extension). The extension writes here with the Admin SDK;
    // users can read their own subscriptions and start a Checkout by creating a checkout session.
    match /customers/{uid} {
      allow read: if isOwner(uid);
      match /checkout_sessions/{id} {
        allow create: if isOwner(uid) && validCheckout(request.resource.data);
      }
      match /{document=**} {
        allow read: if isOwner(uid);
      }
    }
    // Products and prices are public so a pricing page can list them.
    match /products/{productId} {
      allow read: if true;
      match /{document=**} {
        allow read: if true;
      }
    }

    // Everything else is denied (no other match blocks).

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPlan(d) {
      return d.keys().hasOnly(['inputs', 'done', 'logs', 'createdAt', 'updatedAt'])
        && d.inputs is map
        && d.done is map
        && d.done.size() <= 200
        && (!('logs' in d) || (d.logs is map && d.logs.size() <= 200));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['wodMode', 'updatedAt'])
        && (!('wodMode' in d) || d.wodMode in ['solo', 'team']);
    }

    function validCheckout(d) {
      return d.keys().hasOnly(['price', 'mode', 'success_url', 'cancel_url', 'allow_promotion_codes'])
        && d.price is string && d.price.size() <= 100
        && d.mode == 'subscription'
        && d.success_url is string && d.success_url.size() <= 500
        && d.cancel_url is string && d.cancel_url.size() <= 500;
    }
  }
}
